"""Recreate low-rank RNN figures; task realizations are resumable checkpoints."""
configfile: "config/preview.yaml"

FIGURES = {
    "figure1_spontaneous": "spontaneous", "figure2_inputs": "inputs",
    "figure3_go_nogo": "go_nogo", "figure4_detection": "detection",
    "figure5_context": "context", "figure6_integration": "integration",
}
DYNAMICS = "figure1_spontaneous|figure2_inputs"
TASKS = "figure3_go_nogo|figure4_detection|figure5_context|figure6_integration"
ROOT = f"data/{config['profile']}"
SELECTED = config.get("figures", list(FIGURES))
DEFAULTS = dict(architecture="supplement", condition_set="full", transient_duration=10., recovery_duration=0.)


def setting(wildcards, name):
    experiment = FIGURES[wildcards.figure]
    default = config.get(name, DEFAULTS.get(name))
    if name == "baseline_duration" and name not in config:
        default = 7. if experiment == "detection" else 15.
    return config.get("experiments", {}).get(experiment, {}).get(name, default)


def task_command(wildcards):
    return (f"--architecture {setting(wildcards, 'architecture')} "
            f"--condition-set {setting(wildcards, 'condition_set')} "
            f"--baseline-duration {setting(wildcards, 'baseline_duration')} "
            f"--transient-duration {setting(wildcards, 'transient_duration')} "
            f"--recovery-duration {setting(wildcards, 'recovery_duration')}")


rule all:
    input:
        ROOT + "/index.html"


rule simulate_dynamics:
    input:
        "src/lowrank/__init__.py", "src/lowrank/network.py", "src/lowrank/dynamics_figures.py", "src/lowrank/meanfield.py"
    output:
        ROOT + "/simulations/{figure}.npz"
    wildcard_constraints:
        figure=DYNAMICS
    params:
        experiment=lambda wc: FIGURES[wc.figure],
        size=lambda wc: setting(wc, "size"), trials=lambda wc: setting(wc, "trials"),
        seed=config["seed"], dt=config["dt"], duration=lambda wc: setting(wc, "duration"),
    threads: 1
    shell:
        "PYTHONPATH='' MPLBACKEND=Agg uv run python -m lowrank run {params.experiment} {output:q} "
        "--size {params.size} --trials {params.trials} --seed {params.seed} --dt {params.dt} --duration {params.duration}"


rule simulate_task_trial:
    input:
        "src/lowrank/__init__.py", "src/lowrank/network.py", "src/lowrank/batched.py",
        "src/lowrank/tasks.py", "src/lowrank/experiments.py", "src/lowrank/protocol.py", "src/lowrank/meanfield.py"
    output:
        ROOT + "/replicates/{figure}/{trial}.npz"
    wildcard_constraints:
        figure=TASKS, trial=r"\d{3}"
    params:
        experiment=lambda wc: FIGURES[wc.figure], size=lambda wc: setting(wc, "size"),
        seed=config["seed"], dt=config["dt"], duration=lambda wc: setting(wc, "duration"),
        trial=lambda wc: int(wc.trial), protocol=task_command,
        sampling="--orthogonal-patterns" if config.get("orthogonal", False) else "",
    threads: 1
    resources:
        mem_mb=lambda wc: max(1024, int(setting(wc, "size")**2 * 12 / 1e6 + 1024))
    shell:
        "PYTHONPATH='' MPLBACKEND=Agg OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 "
        "uv run python -m lowrank run {params.experiment} {output:q} "
        "--size {params.size} --trials 1 --trial-start {params.trial} --seed {params.seed} "
        "--dt {params.dt} --duration {params.duration} {params.sampling} {params.protocol}"


rule aggregate_task:
    input:
        shards=lambda wc: [ROOT + f"/replicates/{wc.figure}/{trial:03}.npz" for trial in range(setting(wc, "trials"))]
    output:
        ROOT + "/simulations/{figure}.npz"
    wildcard_constraints:
        figure=TASKS
    shell:
        "PYTHONPATH='' uv run python -m lowrank aggregate {output:q} {input.shards:q}"


rule detection_theory:
    input:
        "src/lowrank/detection_theory.py", "src/lowrank/meanfield.py"
    output:
        ROOT + "/simulations/figure4_threshold_timescale.npz"
    shell:
        "PYTHONPATH='' uv run python -m lowrank detection-theory {output:q}"


rule plot:
    input:
        data=ROOT + "/simulations/{figure}.npz",
        source=lambda wc: "src/lowrank/dynamics_figures.py" if wc.figure in {"figure1_spontaneous", "figure2_inputs"}
            else "src/lowrank/detection_theory.py" if wc.figure == "figure4_threshold_timescale" else "src/lowrank/plotting.py",
    output:
        ROOT + "/figures/{figure}.{extension}"
    wildcard_constraints:
        figure="|".join([*FIGURES, "figure4_threshold_timescale"]), extension="png|svg"
    shell:
        "PYTHONPATH='' MPLBACKEND=Agg uv run python -m lowrank plot {input.data:q} {output:q}"


rule gallery:
    input:
        figures=expand(ROOT + "/figures/{figure}.{extension}", figure=SELECTED + ["figure4_threshold_timescale"], extension=["png", "svg"]),
        data=expand(ROOT + "/simulations/{figure}.npz", figure=SELECTED + ["figure4_threshold_timescale"]),
    output:
        ROOT + "/index.html"
    params:
        selected=SELECTED
    script:
        "scripts/gallery.py"
